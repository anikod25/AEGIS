# =============================================================================
# AEGIS — Environment Variables
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.
# =============================================================================

# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# MySQL — uses the Docker service name "mysql" as host inside Docker Compose.
# For local dev without Docker, change the host to "localhost".
DATABASE_URL=mysql+pymysql://aegis_user:CHANGE_ME_DB_PASSWORD@mysql:3306/aegis

# Auth
# JWT_SECRET_KEY must be at least 32 characters of random data.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_at_least_32_random_chars
JWT_ALGORITHM=HS256
# 480 minutes (8 hours) — reduce for higher-security deployments.
# Consider 60 minutes for production.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Gemini AI
# Obtain from https://aistudio.google.com/
# Leave as placeholder to run AEGIS with AI features disabled.
GEMINI_API_KEY=CHANGE_ME_your_gemini_api_key

# Frontend (set at build time via ARG in Dockerfile; /api works when served by gateway)
VITE_API_URL=/api

# Docker / MySQL init credentials
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_DATABASE=aegis
MYSQL_USER=aegis_user
MYSQL_PASSWORD=CHANGE_ME_aegis_db_password

# Gateway
GATEWAY_PORT=80
BACKEND_PORT=8000

# Service-to-service (internal Docker network hostnames — do not change for Docker)
BACKEND_HOST=backend
MYSQL_HOST=mysql
