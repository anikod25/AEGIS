# =============================================================================
# AEGIS — Environment Variables
# Copy this file to .env and fill in real values before running.
# =============================================================================

# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# MySQL (uses Docker service name as host when running in Docker)
DATABASE_URL=mysql+pymysql://aegis_user:aegis_password@mysql:3306/aegis

# Auth
JWT_SECRET_KEY=replace-with-a-long-random-value-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Gemini AI
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Frontend (set at build time via ARG in Dockerfile; /api works when served by gateway)
VITE_API_URL=/api

# Docker / MySQL init
MYSQL_ROOT_PASSWORD=replace-with-root-password
MYSQL_DATABASE=aegis
MYSQL_USER=aegis_user
MYSQL_PASSWORD=replace-with-aegis-password

# Gateway
GATEWAY_PORT=80
BACKEND_PORT=8000

# Service-to-service (internal Docker network hostnames — do not change for Docker)
BACKEND_HOST=backend
MYSQL_HOST=mysql
